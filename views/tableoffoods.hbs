<div class="big-list" style="height: 100%; margin: 0 3%; padding-bottom: 10%;">
  <input placeholder="Search" class="fancy-list__header fancy-list__item_search" />
  {{#each products}}
    <div class="fancy-list__item big-list__item">
      <span>{{name}}</span>
      <span>P: {{proteinsNumber}}  F: {{fatsNumber}}  C: {{carbsNumber}}</span>
      <span>{{calculateCalories proteinsNumber carbsNumber fatsNumber}}kcal  100g</span>
    </div>
  {{/each}}
  <button class="fancy-list__item big-list__item fancy-btn fancy-btn__big-list">Add</button>
</div>
