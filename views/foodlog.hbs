<div class="foodlog__main">
<div class="side side_left">
    <div class="day-selector">
        <i class="fa-solid fa-angle-left" style="color: #606C38; font-size: calc(0.8rem + 1vw)"></i>
        <span class="day-selector__day-text">Today, 3rd Sept.</span>
        <i class="fa-solid fa-angle-right" style="color: #606C38; font-size: calc(0.8rem + 1vw)"></i>
    </div>
    <div class="fancy-list">
        <div class="fancy-list__item fancy-progress_proteins">
            <span>Proteins</span>
            <span>80/140</span>
        </div>
        <div class="fancy-list__item fancy-progress_carbohydrates">
            <span>Carbohydrates</span>
            <span>130/385</span>
        </div>
        <div class="fancy-list__item fancy-progress_fats">
            <span>Fats</span>
            <span>90/80</span>
        </div>
        <div class="fancy-list__item fancy-progress_calories">
            <span>Calories</span>
            <span>2200/3000</span>
        </div>
        <div class="fancy-list__item fancy-progress_water">
            <span>Water</span>
            <span>
                <span id="water-progress">1000</span>/<span id="water-max">1600</span>
            </span>
        </div>
        <div class="fancy-btn-group">
            <button class="fancy-btn fancy-btn__water">+50</button>
            <button class="fancy-btn fancy-btn__water">+150</button>
            <button class="fancy-btn fancy-btn__water">+250</button>
        </div>
        <script src="/js/waterProgress.js"></script>
    </div>
</div>
<div class="side side_right">
    <div class="big-list big-list_with-extra-space">
        <div class="fancy-list fancy-list__group">
            <div class="fancy-list__header">
                1st Food Intake
            </div>
            <div class="fancy-list__item big-list__item">
                <span>Бульмени</span>
                <span>P: 10  F: 30  C: 40</span>
                <span>500kcal  250g</span>
            </div>
        </div>
        <div class="fancy-list fancy-list__group">
            <div class="fancy-list__header">
                <span>2nd Food Intake</span>
            </div>
            <div class="fancy-list__item big-list__item">
                <span>Свиная голова</span>
                <span>P: 20  F: 50  C: 50</span>
                <span>1000kcal  500g</span>
            </div>
            <div class="fancy-list__item big-list__item">
                <span>Сух. "Пять корочек"</span>
                <span>P: 50  F: 10  C: 40</span>
                <span>700kcal  200g</span>
            </div>
        </div>
        <button class="fancy-btn fancy-btn__big-list">Add</button>
    </div>
</div>
</div>
