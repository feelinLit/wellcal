<!--<input placeholder="Search" class="fancy-list__header fancy-list__item_search" />-->
{{#each products}}
  <div class="fancy-list__item big-list__item product-item" data-value="{{{id}}}">
    <span>{{name}}</span>
    <span><span>P: {{proteinsNumber}}</span>  <span>F: {{fatsNumber}}</span>  <span>C: {{carbsNumber}}</span></span>
    <span>{{calculateCalories proteinsNumber carbsNumber fatsNumber}}kcal  100g</span>
  </div>
{{/each}}
<button class="fancy-list__item big-list__item fancy-btn fancy-btn__big-list" id="addButton">Add</button>

<script>
  let selectedProduct;
  let selectedProductJson
  const products = document.querySelectorAll(".product-item");
  products.forEach(n => {
    n.addEventListener('click',  () => {
      products.forEach(p => p.classList.remove('selected'));
      n.classList.add('selected');
      selectedProduct = n;
      let productName = selectedProduct.children[0].innerText;
      let productPFC = selectedProduct.children[1];
      let productP = productPFC.children[0].innerText.slice(3);
      let productF = productPFC.children[1].innerText.slice(3);
      let productC = productPFC.children[2].innerText.slice(3);
      selectedProductJson = {
        name: productName,
        proteinsNumber: +productP,
        fatsNumber: +productF,
        carbsNumber: +productC,
        id: selectedProduct.getAttribute('data-value')};
    });
  });
</script>